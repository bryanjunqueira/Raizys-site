# ============================================================
# RAIZYS — APACHE / LITESPEED CONFIGURATION
# ============================================================
Options -Indexes -MultiViews
DirectoryIndex home.html index.html

RewriteEngine On
RewriteBase /

# 1. Redirecionamento 301 de legado: /empresarial -> /web
RewriteRule ^empresarial/?$ /web [R=301,L,NC]

# 2. Forçar remoção de .html da URL (301 para SEO Canônico)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Rota específica para a LP de conversão: /web/gestao-web -> gestao-web.html
RewriteRule ^web/gestao-web/?$ gestao-web.html [NC,L]

# 4. Rota específica para a solução Web: /web ou /web/ -> web.html
RewriteRule ^web/?$ web.html [NC,L]

# 5. Roteamento automático de URLs limpas na raiz (ex: /sobre-nos -> sobre-nos.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)/?$ $1.html [NC,L]

# ============================================================
# HEADERS DE SEGURANÇA E PERFORMANCE (Core Web Vitals)
# ============================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|woff2|woff|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
